#!/usr/bin/env perl

use 5.008;

use strict;
use warnings;

use Digest::MD5 qw{ md5_hex };
use File::Spec;
use File::stat;
use Getopt::Long 2.33 qw{ :config auto_version };
use Pod::Usage;
use Test::Pod::LinkCheck::Lite;
use YAML;

our $VERSION = '0.014_001';

my %opt;

GetOptions( \%opt,
    help => sub { pod2usage( { -verbose => 2 } ) },
) and @ARGV or pod2usage( { -verbose => 0 } );

my $code = __PACKAGE__->can( "cmd_$ARGV[0]" )
    or die "Unknown command '$ARGV[0]'";

my $t = Test::Pod::LinkCheck::Lite->new(
    check_url	=> 1,
    cache_url_response	=> 1,
);

$code->( $t, @ARGV );

sub cmd_clear {
    my ( $t ) = @_;
    $t->clear_url_cache();
    return;
}

sub cmd_expire {
    my ( $t, undef, $url ) = @_;
    my $key_digest = md5_hex( $url );
    my $cache = $t->__url_cache_object();
    my $path = File::Spec->catfile( $cache->{_cache_dir}, $key_digest );
    my $stat = stat $path
	or return;
    my $now = time;
    $stat->mtime() + $cache->{expires_in} <= $now
	and return;
    my $utime = $now - $cache->{expires_in};
    utime $utime, $utime, $path
	and return;
    die "Failed to expire $url: $!\n";
}

sub cmd_head {
    my ( $t, undef, $url ) = @_;
    my $resp = $t->__url_cache_head( $url );
    print Dump( $resp );
    return;
}

sub cmd_list {
    my ( $t ) = @_;
    my $cache = $t->__url_cache_object();
    -d $cache->{_cache_dir}
	or return;
    my @keys;
    opendir my $dh, $cache->{_cache_dir}
	or die "Failed to open $cache->{_cache_dir}: $!\n";
    while ( defined( my $file = readdir $dh ) ) {
	$file =~ m/ [^[:xdigit:]] /smx
	    and next;
	my $path = File::Spec->catfile( $cache->{_cache_dir}, $file );
	my $data = Storable::retrieve( $path );
	push @keys, $data->{key};
    }
    print "$_\n" for sort @keys;
    return;
}

sub cmd_path {
    my ( $t ) = @_;
    print $t->__url_cache_path(), "\n";
    return;
}

sub cmd_purge {
    my ( $t ) = @_;
    $t->purge_url_cache();
    return;
}

__END__

=head1 TITLE

url_cache - Manipulate the persistant URL cache.

=head1 SYNOPSIS

 url_cache list
 url_cache --help
 url_cache --version

=head1 OPTIONS

=head2 --help

This option displays the documentation for this script. The script then
exits.

=head2 --version

This option displays the version of this script. The script then exits.

=head1 DETAILS

This Perl script manipulates the persistant URL status cache. The action
taken depends on the command arguments. This first such is the name of
the subcommand, followed by arguments to the subcommand, if any. The
subcommands currently implemented are:

=over

=item clear

This subcommand removes all entries from the cache.

=item expire E<lt>urlE<gt>

This subcommand expires the entry for the given URL, if any.

=item head E<lt>urlE<gt>

This subcommand retrieves the results of a C<HEAD> request for the given
C<URL>, from the cache if it is there, or from the internet. By results
we mean the L<HTTP::Tiny|HTTP::Tiny> respomnse hash, formatted by
L<YAML|YAML>.

=item list

This subcommand lists the URLs in the cache.

=item path

This subcommand displays the path to the cache.

=item purge

This subcommand removes expired entries from the cache.

=back

