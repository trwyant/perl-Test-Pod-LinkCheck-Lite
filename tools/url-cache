#!/usr/bin/env perl

use 5.008;

use strict;
use warnings;

use Cache::FileCache;		# Not core
use File::Path qw{ rmtree };	# Core since 5.001
use File::Spec;			# Core since 5.4.5
use File::stat;			# Core since 5.4
use HTTP::Tiny;			# Core since 5.13.9
use Getopt::Long 2.33 qw{ :config auto_version };
use Pod::Usage;
use Test::Pod::LinkCheck::Lite qw{ :const };
use YAML;			# Not core

our $VERSION = '0.014_006';

my %opt;
my %new_arg;

GetOptions( \%opt,
    default	=> sub { delete $new_arg{cache_location} },
    'location=s' => sub { $new_arg{$_[0]} = $_[1] },
    memory	=> sub { $new_arg{cache_location} = CACHE_LOC_MEMORY },
    temp	=> sub { $new_arg{cache_location} = CACHE_LOC_TEMP },
    user	=> sub { $new_arg{cache_location} = CACHE_LOC_USER },
    help => sub { pod2usage( { -verbose => 2 } ) },
) and @ARGV or pod2usage( { -verbose => 0 } );

my $code = __PACKAGE__->can( "cmd_$ARGV[0]" )
    or die "Unknown command '$ARGV[0]'";

my $t = Test::Pod::LinkCheck::Lite->new( %new_arg );
my $cache_path = $t->cache_location();
my $cache = $t->__cache_object();

$code->( @ARGV );

exit;

sub cmd_clear {
    $cache->clear();
    return;
}

sub cmd_dump {
    my ( undef, $key ) = @_;
    print Dump( defined( $key ) ? $cache->get_object( $key ) : $cache );
    return;
}

sub cmd_get {
    my ( undef, $key ) = @_;
    if ( my $value = $cache->get( $key ) ) {
	print "$key ", Dump( $value );
    } else {
	print "$key is expired, or not in the cache\n";
    }
    return;
}

{
    my $ua;
    sub cmd_head {
	my ( undef, $url ) = @_;
	my $resp;
	unless ( $resp = $cache->get( $url ) ) {
	    $ua ||= HTTP::Tiny->new();
	    $resp = $ua->head( $url );
	    $cache->set( $url, $resp );
	}
	print Dump( $resp );
	return;
    }
}

sub cmd_list {
    my @keys;
    foreach ( $cache->get_keys() ) {
	$cache->get( $_ )
	    and push @keys, $_;
    }
    print "$_\n" for sort @keys;
    return;
}

sub cmd_obliterate {
    ref $cache_path
	and return;
    rmtree( $cache_path );
    return;
}

sub cmd_path {
    print "$cache_path\n";
    return;
}

sub cmd_purge {
    $cache->purge();
    return;
}

sub cmd_remove {
    my ( undef, $key ) = @_;
    $cache->remove( $key );
    return;
}

__END__

=head1 TITLE

url-cache - Manipulate the URL cache.

=head1 SYNOPSIS

 url-cache list
 url-cache --help
 url-cache --version

=head1 OPTIONS

=head2 --default

This option puts the cache in the default location.

=head2 --location

 --location ~/fubar

This option puts the cache in the specified location.

=head2 --help

This option displays the documentation for this script. The script then
exits.

=head2 --memory

This option puts the cache in memory. This is relatively useless, since
the cache does not persist beyond the execution of this script.

=head2 --temp

This option puts the cache in C<< File::Spec->tempdir() >>.

=head2 --user

This option puts the cache in
C<< File::HomeDir->my_dist_config( 'Test-Pod-LinkCheck-Lite' ) >>.

=head2 --version

This option displays the version of this script. The script then exits.

=head1 DETAILS

This Perl script manipulates the URL status cache.

The location of the cache is specified by the L<--default|/--default>,
L<--location|/--location>, L<--memory|/--memory>, L<--temp|/--temp>, or
L<--user|/--user> options, If more than one of these is specified, the
rightmost wins.

The action taken depends on the command arguments. This first such is
the name of the sub-command, followed by arguments to the sub-command,
if any. The sub-commands currently implemented are:

=over

=item clear

This sub-command removes all entries from the cache.

=item dump

If given a E<lt>urlE<gt> argument, the object for that URL is dumped.
Otherwise the cache object is dumped.

=item get E<lt>urlE<gt>

This sub-command displays the cached data for the given URL, if any. It
ignores expired cache entries.

=item head E<lt>urlE<gt>

This sub-command retrieves the results of a C<HEAD> request for the given
C<URL>, from the cache if it is there, or from the internet. By results
we mean the L<HTTP::Tiny|HTTP::Tiny> response hash, formatted by
L<YAML|YAML>.

=item list

This sub-command lists all URLs in the cache.

=item obliterate

This sub-command removes the root directory of the cache.
I<Caveat user.>

=item path

This sub-command displays the path to the cache.

=item purge

This sub-command removes expired entries from the cache.

=item remove E<lt>urlE<gt>

This sub-command removes the given URL from the cache.

=back

