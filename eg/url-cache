#!/usr/bin/env perl

use 5.008;

use strict;
use warnings;

use Cache::FileCache;		# Not core
use Digest::MD5 qw{ md5_hex };
use File::Path qw{ rmtree };
use File::Spec;			# Core since 5.4.5
use File::stat;			# Core since 5.4
use HTTP::Tiny;			# Core since 5.13.9
use Getopt::Long 2.33 qw{ :config auto_version };
use Pod::Usage;
use Test::Pod::LinkCheck::Lite;
use YAML;			# Not core

our $VERSION = '0.014_004';

my %opt;

GetOptions( \%opt,
    help => sub { pod2usage( { -verbose => 2 } ) },
) and @ARGV or pod2usage( { -verbose => 0 } );

my $code = __PACKAGE__->can( "cmd_$ARGV[0]" )
    or die "Unknown command '$ARGV[0]'";

my $cache_path = Test::Pod::LinkCheck::Lite::__url_cache_path();
my $cache = Cache::FileCache->new( {
	auto_purge_interval	=> 86_400,
	cache_root		=> $cache_path,
	default_expires_in	=> 86_400,
    },
);

$code->( $cache, @ARGV );

sub cmd_clear {
    my ( $cache ) = @_;
    $cache->clear();
    return;
}

sub cmd_dump {
    my ( $cache ) = @_;
    print Dump( $cache );
    return;
}

sub cmd_get {
    my ( $cache, undef, $key ) = @_;
    if ( my $value = $cache->get( $key ) ) {
	print "$key ", Dump( $value );
    } else {
	print "$key is expired, or not in the cache\n";
    }
    return;
}

{
    my $ua;
    sub cmd_head {
	my ( $cache, undef, $url ) = @_;
	my $resp;
	unless ( $resp = $cache->get( $url ) ) {
	    $ua ||= HTTP::Tiny->new();
	    $resp = $ua->head( $url );
	    $cache->set( $url, $resp );
	}
	print Dump( $resp );
	return;
    }
}

sub cmd_list {
    my ( $cache ) = @_;
    my @keys;
    foreach ( $cache->get_keys() ) {
	$cache->get( $_ )
	    and push @keys, $_;
    }
    print "$_\n" for sort @keys;
    return;
}

sub cmd_obliterate {
    my ( $cache ) = @_;
    rmtree( $cache_path );
    return;
}

sub cmd_path {
    print "$cache_path\n";
    return;
}

sub cmd_purge {
    my ( $cache ) = @_;
    $cache->purge();
    return;
}

sub cmd_remove {
    my ( $cache, undef, $key ) = @_;
    $cache->remove( $key );
    return;
}

__END__

=head1 TITLE

url-cache - Manipulate the persistent URL cache.

=head1 SYNOPSIS

 url-cache list
 url-cache --help
 url-cache --version

=head1 OPTIONS

=head2 --help

This option displays the documentation for this script. The script then
exits.

=head2 --version

This option displays the version of this script. The script then exits.

=head1 DETAILS

This Perl script manipulates the persistent URL status cache. The action
taken depends on the command arguments. This first such is the name of
the sub-command, followed by arguments to the sub-command, if any. The
sub-commands currently implemented are:

=over

=item clear

This sub-command removes all entries from the cache.

=item dump

This sub-command dumps the cache object.

=item get E<lt>urlE<gt>

This sub-command displays the cached data for the given URL, if any. It
ignores expired cache entries.

=item head E<lt>urlE<gt>

This sub-command retrieves the results of a C<HEAD> request for the given
C<URL>, from the cache if it is there, or from the internet. By results
we mean the L<HTTP::Tiny|HTTP::Tiny> response hash, formatted by
L<YAML|YAML>.

=item list

This sub-command lists all URLs in the cache, whether or not expired.

=item obliterate

This sub-command removes the root directory of the cache.
I<Caveat user.>

=item path

This sub-command displays the path to the cache.

=item purge

This sub-command removes expired entries from the cache.

=item remove E<lt>urlE<gt>

This sub-command removes the given URL from the cache.

=back

